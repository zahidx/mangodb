# ===========================================
# MangoBite Market — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# cp .env.local.example .env.local

# Supabase Configuration
# Get these from: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key is REQUIRED for the abandoned cart CRON job (keep secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=MangoBite Market

# Resend Email Configuration
# Get from: https://resend.com
RESEND_API_KEY=re_your_resend_api_key_here

# SSLCommerz Payment Gateway
# Get from your merchant dashboard (use sandbox keys for testing)
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=testpassword

# Marketing & Analytics Pixels
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_FB_PIXEL_ID=000000000000000

# Vercel Cron Security
# Generate a random string (e.g. openssl rand -base64 32)
CRON_SECRET=your_super_secret_cron_string_here
